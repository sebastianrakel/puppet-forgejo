<%- | Optional[String] $database_service,
      Optional[String] $tmp_dir,
      String $home,
      String $user,
      String $group,
      String $config_dir,
| -%>

[Unit]
Description=Forgejo (Beyond coding. We forge.)
After=syslog.target
After=network.target

<% if $database_service { -%>
Wants=<%= $database_service %>.service
After=<%= $database_service %>.service
<% } -%>

[Service]
RestartSec=2s
Type=simple
User=<%= $user %>
Group=<%= $group %>
WorkingDirectory=<%= $home %>

ExecStart=/usr/local/bin/forgejo web --config <%= $config_dir %>/app.ini
Restart=always
Environment=USER=<%= $user %> HOME=<%= $home %> GITEA_WORK_DIR=<%= $home %> <% if $tmp_dir {%>TMPDIR=<%= $tmp_dir %><% } %>

[Install]
WantedBy=multi-user.target
